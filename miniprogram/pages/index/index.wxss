.search-bar {
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-placeholder {
  color: #909399;
  font-size: 26rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
  margin-bottom: 20rpx;
}
.more {
  font-size: 24rpx;
  color: #909399;
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.category-name {
  font-size: 24rpx;
  color: #606266;
}
.book-scroll {
  white-space: nowrap;
}
.book-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  vertical-align: top;
}
.book-cover {
  width: 200rpx;
  height: 260rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.cover-text {
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 0 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.book-title {
  font-size: 26rpx;
  color: #303133;
  font-weight: 500;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.book-author {
  font-size: 22rpx;
  color: #909399;
  display: block;
  margin-top: 4rpx;
}
.book-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.borrow-count {
  font-size: 20rpx;
  color: #909399;
}
.book-list {
  display: flex;
  flex-direction: column;
}
.book-list-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.book-list-item:last-child {
  border-bottom: none;
}
.book-cover-small {
  width: 120rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #409eff 0%, #667eea 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cover-text-small {
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 8rpx;
}
.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.book-publisher {
  font-size: 22rpx;
  color: #909399;
  margin-top: 4rpx;
}
.book-status {
  display: flex;
  align-items: center;
  margin-top: auto;
  gap: 12rpx;
}
.available {
  font-size: 22rpx;
  color: #67c23a;
}
